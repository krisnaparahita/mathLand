# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database: PostgreSQL connection string
# Local example: postgres://postgres:postgres@localhost:5432/mathland
# On TCB this is injected automatically, leave it unset there
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mathland

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
